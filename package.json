{
  "name": "gilmorehill-campus-nav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "survey:fetch": "node scripts/fetch-osm.mjs",
    "survey:build": "node scripts/build-survey.mjs",
    "survey:plan": "node scripts/field-plan.mjs",
    "survey:check": "node scripts/check-survey.mjs",
    "survey": "npm run survey:fetch && npm run survey:build && npm run survey:plan",
    "survey:import": "node scripts/build-survey.mjs",
    "survey:report": "esbuild scripts/report.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/report.mjs --log-level=error && node node_modules/.cache/report.mjs",
    "survey:sensitivity": "node scripts/sensitivity.mjs",
    "survey:walk-compare": "node scripts/walk-compare.mjs",
    "survey:export-plot": "node scripts/export-plot.mjs",
    "survey:figures": "node scripts/export-figures.mjs && python scripts/figures.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
